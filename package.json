{
  "name": "@gui-template/core",
  "version": "0.1.0",
  "description": "A lightweight, cross-platform UI foundation for browsers and native webviews.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HighlyConfusedEngineer/GuiKit.git"
  },
  "homepage": "https://github.com/HighlyConfusedEngineer/GuiKit#readme",
  "bugs": {
    "url": "https://github.com/HighlyConfusedEngineer/GuiKit/issues"
  },
  "type": "module",
  "types": "./src/gui.d.ts",
  "exports": {
    ".": {
      "types": "./src/gui.d.ts",
      "import": "./src/gui.js",
      "default": "./src/gui.js"
    },
    "./styles": "./src/gui.css",
    "./modules": {
      "types": "./src/core/module-registry.d.ts",
      "import": "./src/core/module-registry.js",
      "default": "./src/core/module-registry.js"
    },
    "./node-editor": {
      "types": "./src/modules/node-editor/index.d.ts",
      "import": "./src/modules/node-editor/index.js",
      "default": "./src/modules/node-editor/index.js"
    },
    "./media-player": {
      "types": "./src/modules/media-player/index.d.ts",
      "import": "./src/modules/media-player/index.js",
      "default": "./src/modules/media-player/index.js"
    },
    "./statusbar": {
      "types": "./src/modules/statusbar/index.d.ts",
      "import": "./src/modules/statusbar/index.js",
      "default": "./src/modules/statusbar/index.js"
    },
    "./wizard": {
      "types": "./src/modules/wizard/index.d.ts",
      "import": "./src/modules/wizard/index.js",
      "default": "./src/modules/wizard/index.js"
    },
    "./logging": {
      "types": "./src/modules/logging/index.d.ts",
      "import": "./src/modules/logging/index.js",
      "default": "./src/modules/logging/index.js"
    },
    "./logging/node": {
      "types": "./src/modules/logging/node.d.ts",
      "import": "./src/modules/logging/node.js",
      "default": "./src/modules/logging/node.js"
    },
    "./commands": {
      "types": "./src/modules/commands/index.d.ts",
      "import": "./src/modules/commands/index.js",
      "default": "./src/modules/commands/index.js"
    },
    "./overlays": {
      "types": "./src/modules/overlays/index.d.ts",
      "import": "./src/modules/overlays/index.js",
      "default": "./src/modules/overlays/index.js"
    },
    "./runtime": {
      "types": "./src/modules/runtime/index.d.ts",
      "import": "./src/modules/runtime/index.js",
      "default": "./src/modules/runtime/index.js"
    },
    "./forms": {
      "types": "./src/modules/forms/index.d.ts",
      "import": "./src/modules/forms/index.js",
      "default": "./src/modules/forms/index.js"
    },
    "./data-views": {
      "types": "./src/modules/data-views/index.d.ts",
      "import": "./src/modules/data-views/index.js",
      "default": "./src/modules/data-views/index.js"
    },
    "./workspace": {
      "types": "./src/modules/workspace/index.d.ts",
      "import": "./src/modules/workspace/index.js",
      "default": "./src/modules/workspace/index.js"
    },
    "./devtools": {
      "types": "./src/modules/devtools/index.d.ts",
      "import": "./src/modules/devtools/index.js",
      "default": "./src/modules/devtools/index.js"
    },
    "./performance": {
      "types": "./src/modules/performance/index.d.ts",
      "import": "./src/modules/performance/index.js",
      "default": "./src/modules/performance/index.js"
    },
    "./editors": {
      "types": "./src/modules/editors/index.d.ts",
      "import": "./src/modules/editors/index.js",
      "default": "./src/modules/editors/index.js"
    },
    "./platform": {
      "types": "./src/modules/platform/index.d.ts",
      "import": "./src/modules/platform/index.js",
      "default": "./src/modules/platform/index.js"
    },
    "./adapters": {
      "types": "./src/adapters/index.d.ts",
      "import": "./src/adapters/index.js",
      "default": "./src/adapters/index.js"
    }
  },
  "files": [
    "src",
    "locales",
    "docs",
    "examples/csharp",
    "examples/full-demo/app.js",
    "examples/full-demo/demo.css",
    "examples/full-demo/index.html",
    "examples/full-demo/README.md",
    "examples/full-demo/server.mjs",
    "examples/python/app.py",
    "tools/create-module.mjs",
    "index.html",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "demo:full": "node examples/full-demo/server.mjs",
    "check": "node --check src/gui.js && node --check src/core/module-registry.js && node --check src/modules/node-editor/index.js && node --check src/modules/media-player/index.js && node --check src/modules/statusbar/index.js && node --check src/modules/wizard/index.js && node --check src/modules/logging/index.js && node --check src/modules/logging/node.js && node --check src/modules/commands/index.js && node --check src/modules/overlays/index.js && node --check src/modules/runtime/index.js && node --check src/modules/forms/index.js && node --check src/modules/data-views/index.js && node --check src/modules/workspace/index.js && node --check src/modules/devtools/index.js && node --check src/modules/performance/index.js && node --check src/modules/performance/analysis-worker.js && node --check src/modules/editors/index.js && node --check src/modules/platform/index.js && node --check src/adapters/index.js && node --check examples/full-demo/app.js && node --check examples/full-demo/server.mjs && node --check tools/create-module.mjs && node --test",
    "test": "node --test",
    "prepack": "npm run check",
    "release:check": "npm pack --dry-run --ignore-scripts",
    "create:module": "node tools/create-module.mjs"
  },
  "keywords": [
    "gui",
    "web-components",
    "webview",
    "cross-platform",
    "i18n",
    "live-chart",
    "toast",
    "node-editor",
    "visual-programming",
    "video-player",
    "live-stream",
    "media-stream",
    "structured-logging",
    "observability",
    "statusbar",
    "application-status",
    "wizard",
    "stepper",
    "onboarding",
    "command-palette",
    "undo-redo",
    "data-grid",
    "tree-view",
    "schema-forms",
    "docking-workspace",
    "accessibility"
  ],
  "license": "MIT"
}
